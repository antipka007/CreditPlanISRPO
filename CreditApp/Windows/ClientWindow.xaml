<Window x:Class="CreditApp.Windows.ClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Личный кабинет"
        Height="650" Width="1000"
        Background="{StaticResource PrimaryBrush}"
        WindowStartupLocation="CenterScreen">
    <Border Style="{StaticResource CardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="10,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Личный кабинет клиента"
                           Style="{StaticResource TitleText}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="userText"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,0,10,0"/>
                    <Button Content="Выйти"
                            Style="{StaticResource DangerButton}"
                            FontSize="14"
                            Padding="12,4"
                            Margin="0"
                            Click="logoutBtn_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="10,5,5,10">
                    <Button Content="Мои счета" Style="{StaticResource NavButton}" Click="accountsBtn_Click"/>
                    <Button Content="Кредитные планы" Style="{StaticResource NavButton}" Click="plansBtn_Click"/>
                    <Button Content="Мои заявки" Style="{StaticResource NavButton}" Click="requestsBtn_Click"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{StaticResource PanelBrush}"
                        CornerRadius="8"
                        Margin="5,5,10,10">
                    <Frame x:Name="mainFrame" NavigationUIVisibility="Hidden" Margin="10"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
