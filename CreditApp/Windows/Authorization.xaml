<Window x:Class="CreditApp.Windows.Authorization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CreditApp"
        mc:Ignorable="d"
        Title="Вход в систему" Height="450" Width="300" Background="#FF00A3DA" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid>
        <Border Background="White"
                BorderThickness="1" 
                BorderBrush="White"
                CornerRadius="20, 0, 20, 0"
                Margin="20">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Вход в систему"
                           TextAlignment="Center"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="10, 10"/>
                <Label Content="Логин" FontSize="16" Margin="10,0"/>
                <TextBox x:Name="loginTxtBox"
                         Margin="10,0"
                         FontSize="14"
                         Padding="0,5"/>
                <Label Content="Пароль" FontSize="16" Margin="10,0"/>
                <PasswordBox x:Name="passTxtBox"
                             Margin="10,0, 10, 20"
                             FontSize="14"
                             Padding="0,5"/>
                <Border Background="#FF00A3DA"
                        BorderThickness="1" 
                        BorderBrush="White"
                        CornerRadius="5"
                        Margin="10">
                    <Button Margin="10"
                            x:Name="authBtn"
                            Content="Войти"
                            BorderThickness="0"
                            Background="#FF00A3DA" 
                            Foreground="White" 
                            FontSize="20" Click="authBtn_Click"/>
                </Border>
                <Border Background="#FF1AD82F"
                        BorderThickness="1" 
                        BorderBrush="White"
                        CornerRadius="5"
                        Margin="10">
                    <Button x:Name="regBtn"
                            Margin="10"
                            BorderThickness="0"
                            Content="Зарегистрироваться" 
                            Background="#FF1AD82F" 
                            Foreground="White" 
                            FontSize="20" Click="regBtn_Click"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
