<Window x:Class="CreditApp.Windows.Registration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CreditApp.Windows"
        mc:Ignorable="d"
        Title="Регистрация" Height="800" Width="400" Background="#FF00A3DA" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Grid>
        <Border Background="White"
            BorderThickness="1" 
            BorderBrush="White"
            CornerRadius="20, 0, 20, 0"
            Margin="20">

            <StackPanel Orientation="Vertical">
                <TextBlock Text="Регистрация"
                           TextAlignment="Center"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="10, 10"/>
                <Label Content="Введите фамилию" FontSize="16" Margin="10,0"/>
                <TextBox x:Name="secondNameTxtBox"
                         Margin="10,0"
                         FontSize="14"
                         Padding="0,5"/>
                <Label Content="Введите имя" FontSize="16" Margin="10,0"/>
                <TextBox x:Name="firstNameTxtBox"
                         Margin="10,0"
                         FontSize="14"
                         Padding="0,5"/>
                <Label Content="Введите отчество" FontSize="16" Margin="10,0"/>
                <TextBox x:Name="fathersnameNameTxtBox"
                         Margin="10,0"
                         FontSize="14"
                         Padding="0,5"/>
                <Label Content="Ваш пол" FontSize="16" Margin="10,0"/>
                <ComboBox x:Name="genderBox"
                          Margin="10,0"
                          FontSize="14"
                          Padding="5,5">
                    <ComboBoxItem Name="male" IsSelected="True" Content="Мужской"/>
                    <ComboBoxItem Name="female" Content="Женский"/>
                </ComboBox>
                <Label Content="Введите email" FontSize="16" Margin="10,0"/>
                <TextBox x:Name="emailTxtBox"
                         Margin="10,0"
                         FontSize="14"
                         Padding="0,5"/>
                <Label Content="Введите телефон" FontSize="16" Margin="10,0"/>
                <TextBox x:Name="phoneTxtBox"
                         Margin="10,0"
                         FontSize="14"
                         Padding="0,5"/>
                <Label Content="Введите логин" FontSize="16" Margin="10,0"/>
                <TextBox x:Name="loginTxtBox"
                         Margin="10,0"
                         FontSize="14"
                         Padding="0,5"/>
                <Label Content="Введите пароль" FontSize="16" Margin="10,0"/>
                <PasswordBox x:Name="passTxtBox"
                             Margin="10,0, 10, 0"
                             FontSize="14"
                             Padding="0,5"/>
                <Label Content="Повторите пароль" FontSize="16" Margin="10,0"/>
                <PasswordBox x:Name="doublePassTxtBox"
                             Margin="10,0, 10, 10"
                             FontSize="14"
                             Padding="0,5"/>
                <Border Background="#FF1AD82F"
                            BorderThickness="1" 
                            BorderBrush="White"
                            CornerRadius="5"
                            Margin="10">
                    <Button x:Name="regBtn"
                                Margin="10"
                                BorderThickness="0"
                                Content="Зарегистрироваться" 
                                Background="#FF1AD82F" 
                                Foreground="White" 
                                FontSize="20"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
