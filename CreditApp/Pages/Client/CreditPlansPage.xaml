<Page x:Class="CreditApp.Pages.Client.CreditPlansPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Кредитные планы"
      Background="Transparent"
      Loaded="Page_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Кредитные планы"
                   Style="{StaticResource SubTitleText}"/>
        <TextBlock Grid.Row="0"
                   Text="Выберите план, укажите сумму и срок, затем отправьте заявку"
                   FontSize="13"
                   Foreground="{StaticResource MutedBrush}"
                   Margin="10,2,10,0"/>

        <DataGrid Grid.Row="1"
                  x:Name="plansGrid"
                  Style="{StaticResource DataGridStyle}"
                  Margin="10"
                  SelectionChanged="plansGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding id_credit_plan}" Width="60"/>
                <DataGridTextColumn Header="Процент, %" Binding="{Binding cred_percent}" Width="*"/>
                <DataGridTextColumn Header="Макс. сумма" Binding="{Binding max_balance, StringFormat=N2}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="{StaticResource BorderBrushLight}"
                BorderThickness="1"
                CornerRadius="8"
                Margin="10">
            <StackPanel Margin="10">
                <TextBlock x:Name="selectedPlanText"
                           Text="План не выбран"
                           FontSize="14"
                           Foreground="{StaticResource MutedBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <StackPanel>
                        <Label Content="Сумма кредита" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="sumBox" Style="{StaticResource InputBox}" Width="200"/>
                    </StackPanel>
                    <StackPanel>
                        <Label Content="Срок, мес." Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="monthsBox" Style="{StaticResource InputBox}" Width="140"/>
                    </StackPanel>
                    <Button Content="Отправить заявку"
                            Style="{StaticResource SuccessButton}"
                            FontSize="16"
                            VerticalAlignment="Bottom"
                            Click="sendRequestBtn_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
