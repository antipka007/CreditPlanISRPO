<Page x:Class="CreditApp.Pages.Client.AccountsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Мои счета"
      Background="Transparent"
      Loaded="Page_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Мои счета" Style="{StaticResource SubTitleText}"/>

        <DataGrid Grid.Row="1"
                  x:Name="accountsGrid"
                  Style="{StaticResource DataGridStyle}"
                  Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер счета" Binding="{Binding account_number}" Width="*"/>
                <DataGridTextColumn Header="Баланс" Binding="{Binding balance, StringFormat=N2}" Width="*"/>
                <DataGridTextColumn Header="Процент, %" Binding="{Binding percent}" Width="*"/>
                <DataGridTextColumn Header="Срок, мес." Binding="{Binding month_quantity}" Width="*"/>
                <DataGridTextColumn Header="Активен" Binding="{Binding isActive}" Width="*"/>
                <DataGridTextColumn Header="Дата открытия" Binding="{Binding open_date, StringFormat=dd.MM.yyyy}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
