<Page x:Class="CreditApp.Pages.Client.RequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Мои заявки"
      Background="Transparent"
      Loaded="Page_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Мои заявки на кредит" Style="{StaticResource SubTitleText}"/>

        <DataGrid Grid.Row="1"
                  x:Name="requestsGrid"
                  Style="{StaticResource DataGridStyle}"
                  Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding id_request}" Width="60"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding summ_credit, StringFormat=N2}" Width="*"/>
                <DataGridTextColumn Header="Процент, %" Binding="{Binding perc_credit}" Width="*"/>
                <DataGridTextColumn Header="Срок, мес." Binding="{Binding month_quantity}" Width="*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="*"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding create_date, StringFormat=dd.MM.yyyy HH:mm}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
