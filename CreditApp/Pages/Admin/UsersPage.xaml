<Page x:Class="CreditApp.Pages.Admin.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Пользователи"
      Background="Transparent"
      Loaded="Page_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Пользователи" Style="{StaticResource SubTitleText}"/>

        <DataGrid Grid.Row="1"
                  x:Name="usersGrid"
                  Style="{StaticResource DataGridStyle}"
                  Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Логин" Binding="{Binding login}" Width="*"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding role}" Width="*"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding fio}" Width="1.5*"/>
                <DataGridTextColumn Header="Email" Binding="{Binding email}" Width="*"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding phone}" Width="*"/>
                <DataGridTextColumn Header="Заблокирован" Binding="{Binding banned}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
